! Campus neutral-flow smoke test. Keep runtime=0 until IBM is generated.
&RUN
iexpnr = 001
runtime = 0.
trestart = 60.
dtmax = 0.2
ladaptive = .true.
nprocx = 2
nprocy = 2
libm = .true.
lrandomize = .true.
irandom = 43
randu = 0.01
/
&DOMAIN
itot = 218
jtot = 270
ktot = 80
xlen = 1090.
ylen = 1350.
xlat = 31.84
/
&PHYSICS
lcoriol = .true.
lbuoyancy = .false.
ltempeq = .false.
lmoist = .false.
/
&DYNAMICS
ipoiss = 0
/
&NAMSUBGRID
lvreman = .true.
/
&WALLS
iwallmom = 3
iwalltemp = 1
iwallmoist = 1
/
&ENERGYBALANCE
lEB = .false.
/
&OUTPUT
lfielddump = .true.
tfielddump = 10.
fieldvars = 'u0,v0,w0'
ltdump = .false.
lxytdump = .true.
tstatsdump = 10.
tsample = 1.
/
&INPS
zsize = 400.
u0 = 8.0
v0 = 0.0
thl0 = 288.
qt0 = 0.
tke = 0.1
gen_geom = .true.
stl_file = 'geom.001.stl'
stl_ground = .true.
nompthreads = 4
/

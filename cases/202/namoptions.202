! Campus thermal reference scenario based on official 201.
! runtime=0 until IBM, radiation and facet temperatures are generated.
&RUN
iexpnr = 202
runtime = 0.
trestart = 200.
dtmax = 0.2
irandom = 43
randqt = 2.5e-5
randthl = 0.001
randu = 0.01
ladaptive = .true.
nprocx = 2
nprocy = 2
libm = .true.
lrandomize = .true.
lwarmstart = .false.
/
&DOMAIN
itot = 218
jtot = 270
ktot = 80
xlen = 1090.
ylen = 1350.
xlat = 31.84
/
&PHYSICS
lbuoyancy = .true.
ltempeq = .true.
lmoist = .true.
ps = 101500.
igrw_damp = 0
lcoriol = .true.
lnudge = .true.
tnudge = 10800.
nnudge = 40
/
&DYNAMICS
ipoiss = 0
iadv_thl = 2
iadv_qt = 2
/
&BC
wtsurf = 0.
wqsurf = 0.
thl_top = 288.
qt_top = 0.
qts = 0.
/
&NAMSUBGRID
lvreman = .true.
/
&WALLS
iwallmom = 2
iwalltemp = 2
iwallmoist = 2
/
&ENERGYBALANCE
lEB = .true.
lconstW = .true.
lwriteEBfiles = .true.
dtEB = 2.
bldT = 301.
wsoil = 314.
wgrmax = 451.
wwilt = 172.
wfc = 314.
skyLW = 395.
GRLAI = 2.1
rsmin = 200.
nfaclyrs = 5
lvfsparse = .true.
/
&OUTPUT
lfielddump = .true.
tfielddump = 10.
fieldvars = 'u0,v0,w0,th,qt'
ltdump = .false.
lxytdump = .true.
tstatsdump = 10.
tsample = 1.
/
&INPS
zsize = 400.
u0 = 1.5
v0 = 0.
thl0 = 295.
qt0 = 0.01
facT = 295.
stl_file = 'geom.202.stl'
stl_ground = .true.
gen_geom = .true.
nompthreads = 16
! Freeze the official 201 Python preprocessing radiation defaults.
isolar = 1
solarazimuth = 135.
solarzenith = 28.4066
xazimuth = 90.
I = 800.
Dsky = 250.
ishortwave = 3
ltimedepsw = .false.
view3d_out = 2
periodic_xy = .false.
maxD = 1000.
/
